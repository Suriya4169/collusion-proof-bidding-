# Copy to .env (never commit .env). Everything here is read by the backend at start-up.

# ── Required ───────────────────────────────────────────────────────────────────────────────────────────────────
# JWT_SECRET: signs login tokens. 32+ random characters. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, development uses a random per-process key (logins do not survive a restart) and
# PROCUREGUARD_ENV=production refuses to start. docker compose requires it.
JWT_SECRET=

# M2M_MASTER_KEY: the X-ProcureGuard-Key for machine-to-machine clients. Unset = the M2M gateway is switched off.
M2M_MASTER_KEY=

# GEMINI_API_KEY: required for Gemini calls (tender analysis, payment OCR, corrigendum classification).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── Database ───────────────────────────────────────────────────────────────────────────────────────────────────
# Running uvicorn directly with DATABASE_URL empty uses a local SQLite file. docker compose requires DATABASE_URL.
# Option A, local PostgreSQL from docker-compose (also keep COMPOSE_PROFILES=local-db, same password in both places):
#   DATABASE_URL=postgresql://pg_user:CHANGE_ME@postgres:5432/procureguard
#   POSTGRES_PASSWORD=CHANGE_ME
# Option B, Supabase (docs/SUPABASE_SETUP.md): use the pooler string from Project Settings > Database with the
# password URL-encoded, and set COMPOSE_PROFILES to empty. TLS is added automatically and row-level security is
# enabled on every table at start-up.
#   DATABASE_URL=postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
POSTGRES_PASSWORD=
COMPOSE_PROFILES=local-db

# ── Environment and accounts ───────────────────────────────────────────────────────────────────────────────────
# development (default): demo accounts are created (msme@apex.in, auditor@gem.gov.in, admin@procureguard.in, all
# with the published demo password). production: no demo accounts and JWT_SECRET is mandatory.
PROCUREGUARD_ENV=development
# SEED_DEMO_USERS=1 or 0 overrides the demo-account default above.
# With demo accounts off, the first administrator is created from these (password 12+ characters):
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── MCP server (bot-detection tools for AI assistants, at /mcp/, reviewers only) ──────────────────────────────
# The endpoint only answers requests addressed to a host it expects (DNS-rebinding protection). Default: this
# machine. For a deployment list the names clients use, e.g. api.example.org,backend:8000
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=

# ── Agent 4 (behavioural biometrics) ───────────────────────────────────────────────────────────────────────────
# Only needed if the agent-4-behavioral-biometrics folder is not next to backend/.
# AGENT4_ROOT=/path/to/agent-4-behavioral-biometrics

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
