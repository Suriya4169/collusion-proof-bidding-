# Copy to .env and edit. None of these values is a secret except AGENT4_API_KEYS.

# Comma-separated API keys accepted in the X-API-Key header. Generate long random values, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT4_API_KEYS=change-me-generate-a-long-random-value

# true = refuse to start if no key is configured (recommended in production).
AGENT4_REQUIRE_API_KEY=true

# Where the model bundles and manifest.json live (inside the container).
AGENT4_MODEL_DIR=/app/models

# Largest number of keystroke events accepted in one request, and the largest request body.
AGENT4_MAX_EVENTS=2000
AGENT4_MAX_BODY_BYTES=262144

# Optional: require MORE keystrokes than the trained minimum (10) before a session is scored.
# AGENT4_MIN_EVENTS=20

# Optional: browser origins allowed to call the API directly. Leave empty when the browser talks to
# your own backend and the backend calls this service (recommended).
# AGENT4_CORS_ORIGINS=https://bids.example.gov

AGENT4_LOG_LEVEL=INFO
