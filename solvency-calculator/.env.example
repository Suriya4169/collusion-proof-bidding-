# Google Gemini API Key (optional but recommended for LLM layout-aware parsing)
# If omitted, the service falls back to deterministic regex-based extraction.
GEMINI_API_KEY=your_gemini_api_key_here

# Server host and port configuration
HOST=0.0.0.0
PORT=8001

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
